# ========================================================
# FluxForge · 环境变量配置模板 (.env)
# ========================================================

# Supabase 云端数据库配置 (填入你的 Supabase 项目设置 -> API 中的信息)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# 服务端口 (独立后端模式下的端口)
PORT=7300
